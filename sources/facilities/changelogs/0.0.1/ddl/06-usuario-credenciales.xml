<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="ddl-0.0.1-06-01" author="MIND">
        <comment>Credenciales y bloqueo de cuenta sobre usuario (ARC-110; REQ-038, REQ-053, REQ-054, REQ-069, REQ-072)</comment>
        <!--
            password_hash y password_salt son la UNICA representacion persistida de la credencial
            (REQ-063 / REQ-076): en este modelo NO existe ninguna columna de contrasenia en claro,
            ni aqui ni en ninguna tabla derivada; la verificacion se hace siempre recalculando el
            hash con password_algorithm sobre el salt almacenado.

            failed_password_attempts es el contador POR CUENTA (no por sesion ni por navegador):
            vive en la fila de usuario, de modo que los intentos fallidos se acumulan aunque el
            atacante cambie de navegador o de dispositivo. Esta unica columna materializa a la vez
            REQ-055 y REQ-072, y su nombre fisico es exactamente el que fija el DoD de esta tarea.

            locked_until es un bloqueo TEMPORAL: expresa hasta que instante se rechaza el acceso,
            pero NO altera status ni la columna virtual is_active (AC-AUT-04). Una cuenta bloqueada
            sigue siendo una cuenta ACTIVA del censo; el desbloqueo es el simple paso del tiempo o
            la puesta a NULL de esta columna, nunca un cambio de estado de la cuenta.
        -->
        <addColumn tableName="usuario">
            <column name="username" type="VARCHAR2(100 CHAR)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR2(255 CHAR)">
                <constraints nullable="false"/>
            </column>
            <column name="password_salt" type="VARCHAR2(64 CHAR)"/>
            <column name="password_algorithm" type="VARCHAR2(30 CHAR)">
                <constraints nullable="false"/>
            </column>
            <column name="password_updated_at" type="TIMESTAMP(6)"/>
            <column name="must_change_password" type="CHAR(1)" defaultValue="Y">
                <constraints nullable="false"/>
            </column>
            <column name="credential_issued_at" type="TIMESTAMP(6)"/>
            <column name="password_expires_at" type="TIMESTAMP(6)"/>
            <column name="failed_password_attempts" type="NUMBER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_failed_attempt_at" type="TIMESTAMP(6)"/>
            <column name="locked_until" type="TIMESTAMP(6)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="usuario">
                <column name="locked_until"/>
                <column name="last_failed_attempt_at"/>
                <column name="failed_password_attempts"/>
                <column name="password_expires_at"/>
                <column name="credential_issued_at"/>
                <column name="must_change_password"/>
                <column name="password_updated_at"/>
                <column name="password_algorithm"/>
                <column name="password_salt"/>
                <column name="password_hash"/>
                <column name="username"/>
            </dropColumn>
        </rollback>
    </changeSet>

    <changeSet id="ddl-0.0.1-06-02" author="MIND">
        <comment>Reglas de integridad de la credencial y del contador de fallos (REQ-053, REQ-072; T.5 ARC-110)</comment>
        <!--
            ck_usuario_pwd_algorithm acota el algoritmo a los adaptativos aceptados por T.5 de
            ARC-110: al guardarse el algoritmo con cada credencial, una cuenta antigua puede
            rehashearse a argon2id sin migrar el resto del censo.
        -->
        <sql>ALTER TABLE usuario ADD CONSTRAINT ck_usuario_username_len CHECK (LENGTH(username) BETWEEN 3 AND 100)</sql>
        <sql>ALTER TABLE usuario ADD CONSTRAINT ck_usuario_must_change_pwd CHECK (must_change_password IN ('Y','N'))</sql>
        <sql>ALTER TABLE usuario ADD CONSTRAINT ck_usuario_failed_attempts CHECK (failed_password_attempts &gt;= 0)</sql>
        <sql>ALTER TABLE usuario ADD CONSTRAINT ck_usuario_pwd_algorithm CHECK (password_algorithm IN ('argon2id','bcrypt'))</sql>
        <rollback>
            <sql>ALTER TABLE usuario DROP CONSTRAINT ck_usuario_pwd_algorithm</sql>
            <sql>ALTER TABLE usuario DROP CONSTRAINT ck_usuario_failed_attempts</sql>
            <sql>ALTER TABLE usuario DROP CONSTRAINT ck_usuario_must_change_pwd</sql>
            <sql>ALTER TABLE usuario DROP CONSTRAINT ck_usuario_username_len</sql>
        </rollback>
    </changeSet>

    <changeSet id="ddl-0.0.1-06-03" author="MIND">
        <comment>REQ-053: unicidad de username insensible a mayusculas</comment>
        <!--
            La unicidad se impone sobre la EXPRESION LOWER(username), no sobre la columna: este
            indice funcional es lo que hace que 'A@mapfre.com' y 'a@mapfre.com' se normalicen al
            mismo valor y colisionen con ORA-00001 en el segundo INSERT, igual que ya hace
            ux_usuario_email_ci con el correo corporativo.
        -->
        <sql>CREATE UNIQUE INDEX ux_usuario_username_ci ON usuario (LOWER(username))</sql>
        <rollback>
            <sql>DROP INDEX ux_usuario_username_ci</sql>
        </rollback>
    </changeSet>

    <changeSet id="ddl-0.0.1-06-04" author="MIND">
        <comment>Historico de hashes de contrasenia (ARC-111; REQ-069)</comment>
        <!--
            Esta tabla guarda SOLO el hash de las contrasenias que dejaron de ser vigentes: nunca
            la contrasenia en claro (REQ-076 / AC-G-08). La comprobacion de no reutilizacion se
            hace recalculando el hash del candidato y comparandolo con los hashes archivados, de
            modo que el historico no amplia en nada lo que un volcado de la base de datos revela.

            created_at NO es la fecha de alta de la contrasenia, sino el instante en que esa
            contrasenia dejo de ser vigente; lo sella el servidor en UTC con el mismo DEFAULT
            SYS_EXTRACT_UTC(SYSTIMESTAMP) que el resto de marcas de auditoria del proyecto, nunca
            el cliente.
        -->
        <sql>CREATE TABLE usuario_password_historico (
    password_history_id NUMBER GENERATED ALWAYS AS IDENTITY,
    user_id             NUMBER NOT NULL,
    password_hash       VARCHAR2(255 CHAR) NOT NULL,
    created_at          TIMESTAMP(6) DEFAULT SYS_EXTRACT_UTC(SYSTIMESTAMP) NOT NULL,
    CONSTRAINT pk_usuario_password_historico PRIMARY KEY (password_history_id),
    CONSTRAINT fk_usuario_pwd_hist_user FOREIGN KEY (user_id) REFERENCES usuario (user_id)
)</sql>
        <rollback>
            <dropTable tableName="usuario_password_historico"/>
        </rollback>
    </changeSet>

    <changeSet id="ddl-0.0.1-06-05" author="MIND">
        <comment>Indice de consulta del historico por usuario y recencia (REQ-069)</comment>
        <!--
            Es el indice que sirve a los dos accesos del historico: la comprobacion de no
            reutilizacion de las 3 ultimas contrasenias de un usuario y la purga que recorta el
            historico a ese mismo limite. Ambos leen por user_id y ordenan por created_at
            descendente, que es exactamente la forma de esta clave.
        -->
        <sql>CREATE INDEX ix_usuario_pwd_hist_user_fecha ON usuario_password_historico (user_id, created_at DESC)</sql>
        <rollback>
            <sql>DROP INDEX ix_usuario_pwd_hist_user_fecha</sql>
        </rollback>
    </changeSet>

    <changeSet id="ddl-0.0.1-06-06" author="MIND">
        <comment>Purga que conserva como maximo las 3 ultimas contrasenias por usuario (REQ-069 / AC-PWD-04)</comment>
        <!--
            El trigger es de SENTENCIA (AFTER INSERT ON, sin FOR EACH ROW) y no de fila: un trigger
            FOR EACH ROW no puede leer ni borrar la propia tabla que se esta modificando y Oracle
            responderia ORA-04091 (tabla mutante). A nivel de sentencia el INSERT ya ha terminado,
            asi que la tabla es consultable y la purga puede ejecutarse sin restricciones.

            El limite de 3 lo fija REQ-069 ("se conservan como maximo las 3 ultimas por usuario").
            Al vivir la purga en la base de datos, la invariante se cumple siempre y no depende de
            que la aplicacion se acuerde de recortar el historico tras cada cambio de contrasenia.
        -->
        <sql splitStatements="false" stripComments="false">CREATE OR REPLACE TRIGGER trg_usuario_pwd_hist_purga
AFTER INSERT ON usuario_password_historico
BEGIN
    DELETE FROM usuario_password_historico
     WHERE password_history_id IN (
         SELECT password_history_id
           FROM (
               SELECT password_history_id,
                      ROW_NUMBER() OVER (PARTITION BY user_id
                                         ORDER BY created_at DESC, password_history_id DESC) AS rn
                 FROM usuario_password_historico
           )
          WHERE rn &gt; 3
     );
END;</sql>
        <rollback>
            <sql>DROP TRIGGER trg_usuario_pwd_hist_purga</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
